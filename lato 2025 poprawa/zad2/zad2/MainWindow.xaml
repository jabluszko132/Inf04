<Window x:Class="zad2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:zad2"
        mc:Ignorable="d"
        Title="Szyfrowanie. Wykonane przez: 00000000000" Height="450" Width="800" Background="CadetBlue">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="2*"/>
                <RowDefinition/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Label x:Name="label" Content="Podaj wartość klucza" FontSize="20" Foreground="AntiqueWhite"/>
            </Grid>
            <TextBox x:Name="keyIn" AutomationProperties.LabeledBy="{Binding ElementName=label, Mode=OneWay}" AutomationProperties.Name="keyIn" Grid.Row="1" Height="20" Width="100"/>
            <Label x:Name="label2" Content="Podaj tekst" FontSize="20" Foreground="AntiqueWhite" Grid.RowSpan="2" Grid.Row="2"/>
            <TextBox x:Name="txtIn" Grid.Row="3" TextWrapping="Wrap" Margin="20,20,20,20" />
        </Grid>
        <Button x:Name="cypherBtn" Grid.Column="1" Content="Zaszyfruj" HorizontalAlignment="Center" VerticalAlignment="Center" Background="LightBlue" Padding="10,5,10,5" Click="cypherBtn_Click"/>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="5*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Label x:Name="label3" Content="Tekst zaszyfrowany" FontSize="20" Foreground="AntiqueWhite" Grid.Row="0"/>
            <Border Grid.Row="1" BorderBrush="AliceBlue" BorderThickness="3" CornerRadius="20,20,20,20">
                <Label x:Name="cypherRes" Foreground="AntiqueWhite"/>
            </Border>
            <Button x:Name="saveBtn" Grid.Row="2" Width="252" Height="30" Background="LightBlue" Click="saveBtn_Click">Zapisz do pliku</Button>
        </Grid>
    </Grid>
</Window>
